# MongoDB connection string. The database is created automatically on first write.
MONGODB_URI=mongodb://127.0.0.1:27017/invoice_generator

# SMTP server used to send invoice emails (Mailtrap, Gmail app password, SES, etc.).
# These values stay on the server and are never sent to the browser.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Sender shown in the recipient's inbox
MAIL_FROM="Folio Invoices <invoices@example.com>"
